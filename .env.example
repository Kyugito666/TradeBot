# =====================================================================
# DASHBOARD (Next.js frontend) CONFIG
# =====================================================================
# Base URL of the Go trading engine gateway (go-engine/gateway/server.go).
# Local dev default is http://localhost:8765. For Vercel, set this to your
# publicly reachable engine URL (must be HTTPS), e.g. https://engine.example.com
NEXT_PUBLIC_ENGINE_URL=http://localhost:8765

# Public market-data upstream used by /api/market (server-side proxy).
# Defaults to OKX public API which works globally with no API key.
MARKET_API_BASE=https://www.okx.com

# =====================================================================
# TRADING ENGINE (Go/Rust backend) CONFIG
# =====================================================================
# Pilih exchange: bybit atau mexc
EXCHANGE=mexc

# bybit = demo testnet, real = live funds
EXCHANGE_MODE=real

BYBIT_API_KEY=
BYBIT_API_SECRET=
MEXC_API_KEY=
MEXC_API_SECRET=

SYMBOL=SOLUSDT
OI_INTERVAL=60
LOOP_INTERVAL=300
OHLCV_LIMIT=100
RISK_PCT=0.03

DRY_RUN=0
USE_MOCK_OHLCV=0
DB_PATH=bot_state.db
LOG_LEVEL=INFO
LEVERAGE=10
BYBIT_DEMO_API_KEY=
BYBIT_DEMO_API_SECRET=
